# Copy to supabase/functions/.env for local testing (that file is git-ignored).
# For the deployed project, set these with: npx supabase secrets set KEY=value

# Leave empty to get the sample lease result (no Cerebras calls, zero tokens).
CEREBRAS_API_KEY=
# Models on our account: qwen-3.8-27b (smaller), gpt-oss-120b.
CEREBRAS_MODEL=qwen-3.8-27b
# "none" disables hidden thinking tokens. Use "low" if you switch to gpt-oss-120b.
CEREBRAS_REASONING=none
# Token guards
LEASE_DAILY_LIMIT=5
LEASE_MAX_CHARS=12000
